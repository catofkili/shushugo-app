{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "master-nihongo-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_BUNDLE_ID": "com.shushugo.app",
    "APPLE_SIGN_IN_CLIENT_ID": "com.shushugo.app"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "master_nihongo_sync",
      "database_id": "eb7ebca5-8026-41c2-8662-1dbc76eef5d7"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SYNC_DATA",
      "id": "a8a8e2d05d2e4159a26e37e057bd8ebf"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SYNC_BUCKET",
      "bucket_name": "master-nihongo-sync-snapshots"
    }
  ],
  "ratelimits": [
    {
      "name": "SYNC_PUSH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 2, "period": 60 }
    },
    {
      "name": "SYNC_PULL_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 4, "period": 60 }
    },
    {
      "name": "SYNC_STATUS_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
