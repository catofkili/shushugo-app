{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "master-nihongo-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "workers_dev": true,
  "preview_urls": false,
  // api.shushugo.com：小程序的云函数从大陆连不上 workers.dev（被墙），走自己的域名就通。
  // workers.dev 保留 —— 已发布的 iOS 客户端还指着它。域名 DNS 托管在 Cloudflare，
  // custom_domain 会自动建 DNS 记录和证书。
  "routes": [{ "pattern": "api.shushugo.com", "custom_domain": true }],
  "vars": {
    "APP_BUNDLE_ID": "com.shushugo.app",
    "APPLE_SIGN_IN_CLIENT_ID": "com.shushugo.app",
    // 微信个人主体虚拟支付：期限卡单次付款，按北京时间自然月到期；AppKey 是 secret 不在这。
    "WECHAT_OFFER_ID": "1450657377",
    "WECHAT_PAY_ENV": "1",
    "WECHAT_PAY_PRICES": "{\"shushugo_pro_monthly\":1000,\"shushugo_pro_quarterly\":2400,\"shushugo_pro_yearly\":6800,\"shushugo_pro_lifetime\":29800}"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "master_nihongo_sync",
      "database_id": "eb7ebca5-8026-41c2-8662-1dbc76eef5d7"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SYNC_DATA",
      "id": "a8a8e2d05d2e4159a26e37e057bd8ebf"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SYNC_BUCKET",
      "bucket_name": "master-nihongo-sync-snapshots"
    }
  ],
  "ratelimits": [
    {
      "name": "SYNC_PUSH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 2, "period": 60 }
    },
    {
      "name": "SYNC_PULL_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 4, "period": 60 }
    },
    {
      "name": "SYNC_STATUS_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
