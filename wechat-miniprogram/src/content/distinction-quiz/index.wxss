@import "../../features/common.wxss";
.quiz-prompt{padding:46rpx 20rpx;text-align:center}.quiz-meaning{display:block;font-size:38rpx;font-weight:800}.quiz-hint{display:block;margin-top:12rpx;color:#8a7d70}.option{margin-top:14rpx;padding:22rpx;border-radius:20rpx;background:#f3ede3}.right{background:#dceecf;color:#315d35}.wrong{background:#f5dfd9;color:#963f36}
.answer-panel{margin-top:18rpx;padding:20rpx;border:1rpx solid #d7e9cf;border-radius:20rpx;background:#f6f8f3;color:#304134}.answer-summary{display:block;font-size:27rpx;font-weight:700;line-height:1.6}.answer-section-title{display:block;margin-top:18rpx;padding-top:14rpx;border-top:1rpx solid #dce5d7;color:#727d70;font-size:22rpx;font-weight:800}.answer-option{margin-top:12rpx;padding:16rpx;border-radius:16rpx;background:#fff}.answer-word-line{display:flex;align-items:center;flex-wrap:wrap;gap:8rpx}.answer-word{font-size:26rpx;font-weight:800;color:#304134}.answer-kana{font-size:22rpx;font-weight:500;color:#8a9286}.answer-role{padding:4rpx 10rpx;border-radius:999rpx;background:#edf5e7;color:#507047;font-size:20rpx;font-weight:800}.answer-note{display:block;margin-top:8rpx;color:#6b7468;font-size:23rpx;line-height:1.55}.answer-example,.answer-meaning{display:block;margin-top:10rpx;color:#344337;font-size:25rpx;font-weight:700;line-height:1.6;word-break:break-all}.answer-meaning{margin-top:2rpx;color:#6d776b;font-size:23rpx;font-weight:500}.answer-label{margin-right:8rpx;color:#939a90;font-size:20rpx;font-weight:500}
