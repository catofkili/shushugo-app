page { background: #f4ead6; color: #3a2e22; }
.page { min-height: 100vh; box-sizing: border-box; padding: 38rpx 30rpx 76rpx; }
.hero { padding: 12rpx 8rpx 28rpx; }.eyebrow { display: block; color: #69a840; font-size: 20rpx; letter-spacing: 2rpx; font-weight: 800; }.title { display: block; margin-top: 12rpx; font-size: 48rpx; font-weight: 900; }.subtitle,.detail,.mode-note { display: block; margin-top: 10rpx; color: #806f5c; font-size: 23rpx; line-height: 1.5; }
.panel { margin-bottom: 22rpx; padding: 28rpx; border-radius: 28rpx; background: #fbf5e9; box-shadow: 0 10rpx 26rpx rgba(91,67,42,.07); }.notice { margin-bottom: 18rpx; color: #b33; }
.modes { white-space: nowrap; }.mode { display: inline-block; margin: 0 8rpx 0 0; padding: 0 20rpx; line-height: 56rpx; border-radius: 28rpx; color: #806f5c; background: #efe7d8; font-size: 23rpx; }.mode::after { border: 0; }.mode.selected { background: #69a840; color: #fff; }.mode-note { font-size: 21rpx; }
.ring { display: block; width: 240px; height: 240px; margin: 22rpx auto 14rpx; touch-action: none; }.total-row { display: flex; align-items: center; justify-content: center; gap: 10rpx; font-size: 24rpx; font-weight: 800; }.total-row input { width: 95rpx; padding: 6rpx; border-bottom: 2rpx solid #69a840; text-align: center; font-size: 28rpx; }.panel > .detail { text-align: center; }
.row { display: flex; align-items: center; flex-wrap: wrap; padding: 17rpx 10rpx; border-bottom: 1rpx solid #e9dece; }.row.focused { background: #f3eddf; border-radius: 15rpx; }.row.muted { opacity: .45; }.dot { width: 18rpx; height: 18rpx; border-radius: 50%; margin-right: 14rpx; }.row-name { flex: 1; font-weight: 750; }.row-count { font-weight: 850; }.row-detail { width: 100%; padding-left: 32rpx; color: #806f5c; font-size: 21rpx; }
.split { margin-top: 18rpx; padding: 20rpx; border-radius: 18rpx; background: #f3eddf; font-size: 24rpx; }.split .detail { text-align: left; }
.actions { display: flex; gap: 12rpx; }.actions button { flex: 1; }.arrange { margin: 22rpx 0 0; color: #fff; background: #69a840; border-radius: 18rpx; line-height: 78rpx; font-size: 25rpx; }.arrange::after,.undo::after,.suggest::after { border: 0; }.undo { margin: 22rpx 0 0; color: #557d38; background: #e5efd9; border-radius: 18rpx; line-height: 78rpx; font-size: 25rpx; }.suggest { margin-top: 12rpx; color: #557d38; background: #e5efd9; font-size: 23rpx; }.section-title { display: block; font-size: 29rpx; font-weight: 850; }
.form-head,.form-row { display: flex; align-items: center; gap: 14rpx; margin-top: 15rpx; }.form-head text,.form-row text { flex: 1; }.form-head text:not(:first-child) { flex: 0 0 135rpx; text-align: center; }.form-row input { flex: 0 0 135rpx; width: 135rpx; box-sizing: border-box; padding: 9rpx; border: 2rpx solid #ded2bd; border-radius: 12rpx; text-align: center; background: #fff; }
.preset { display: flex; align-items: center; gap: 18rpx; margin-top: 25rpx; font-size: 24rpx; }.picker { padding: 10rpx 18rpx; border-radius: 12rpx; background: #f3eddf; }.link { text-align: left!important; color: #5f983a; }
