page { background: #f4ead6; color: #3a2e22; }
.page { min-height: 100vh; padding: 42rpx 40rpx 72rpx; box-sizing: border-box; }
.hero { padding: 10rpx 8rpx 34rpx; }
.back { color: #69a840; font-size: 25rpx; }
.title { display: block; margin-top: 28rpx; font-size: 52rpx; font-weight: 800; }
.subtitle { display: block; margin-top: 10rpx; color: #806f5c; font-size: 24rpx; }
.card { margin-bottom: 22rpx; padding: 30rpx; border-radius: 26rpx; background: #fbf5e9; box-shadow: 0 10rpx 26rpx rgba(91,67,42,.07); }
.stats { display: flex; justify-content: space-around; text-align: center; color: #806f5c; font-size: 22rpx; }
.stats view { flex: 1; }
.big, .stats text { display: block; }
.big { color: #3a2e22; font-size: 42rpx; font-weight: 800; margin-bottom: 6rpx; }
.row { display: flex; justify-content: space-between; align-items: center; }
.strong { color: #69a840; font-weight: 750; }
.metrics { color: #806f5c; font-size: 25rpx; }
.metrics .row + .row { margin-top: 22rpx; }
.section-title { display: block; margin-bottom: 22rpx; font-weight: 750; }
.level-row { margin-top: 20rpx; color: #806f5c; font-size: 22rpx; }
.level-name { color: #55483c; font-size: 25rpx; font-weight: 700; }
.muted { color: #a08d79; font-size: 20rpx; }.heatmap { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10rpx; margin-top: 20rpx; }.heat { height: 34rpx; border-radius: 8rpx; background: #eadfcf; }.heat-1 { background: #cad7ff; }.heat-2 { background: #8fa8ff; }.heat-3 { background: #69a840; }.link-row { display: flex; justify-content: space-between; margin: 8rpx 4rpx 24rpx; }.link-row navigator { color: #69a840; font-size: 23rpx; }
.bar { height: 12rpx; margin-top: 10rpx; border-radius: 8rpx; background: #eef2f6; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 8rpx; background: #69a840; }
.journey-link { display: block; margin: 14rpx 4rpx 26rpx; color: #69a840; font-size: 23rpx; }
