<scroll-view class="page" scroll-y enable-back-to-top>
  <view class="hero">
    <view class="hero-orb orb-one"></view>
    <view class="hero-orb orb-two"></view>
    <navigator class="back" open-type="navigateBack">‹ 返回</navigator>
    <view class="hero-copy">
      <text class="eyebrow">STUDY TOGETHER</text>
      <text class="title">一起学，会走得更远</text>
      <text class="subtitle">分享今天的脚步，给认真学习的队友加油</text>
    </view>
    <view class="hero-friends" aria-hidden="true">
      <text>🐿️</text><text>🐼</text><text>🐧</text>
    </view>
  </view>

  <view class="content">
    <view wx:if="{{!ready}}" class="card loading-card">
      <view class="loading-leaf">🌱</view>
      <text class="section-title">正在看看队友们…</text>
    </view>

    <view wx:elif="{{needsInit}}" class="card empty-card">
      <view class="empty-icon">📚</view>
      <text class="section-title">先准备好本地学习库</text>
      <text class="detail">组队页会读取你今天的学习数量。初始化完成后再回来，就能和队友同步进度。</text>
      <navigator class="primary nav-button" url="/pages/index/index">去学习首页</navigator>
    </view>

    <block wx:elif="{{!auth.signedIn}}">
      <view class="card welcome-card">
        <view class="card-kicker">开始组队</view>
        <text class="section-title large">先给自己取个队友昵称</text>
        <text class="detail">登录后才能加入真实队伍。已有邮箱或 Apple 账号请先关联微信；只有在确认创建新账号后才会注册。</text>
        <label class="field-label">队友昵称</label>
        <input class="input" value="{{nickname}}" maxlength="20" placeholder="例如：每天背十个" bindinput="inputNickname" />
        <button class="primary" loading="{{busy}}" disabled="{{busy || !nickname.length}}" bindtap="signIn">微信登录并开始</button>
        <navigator class="legal" url="/pages/legal/index">登录即代表已阅读用户协议与隐私政策 →</navigator>
      </view>
      <view class="privacy-note"><text class="privacy-icon">✓</text><text>只公开昵称、队伍和当天学习数量</text></view>
    </block>

    <block wx:elif="{{team}}">
      <view class="team-summary">
        <view class="team-topline">
          <view class="team-mark">{{team.emoji}}</view>
          <view class="team-copy">
            <text class="team-title">{{team.name}}</text>
            <text class="team-meta">{{team.targetLevel}} · {{team.visibility === 'public' ? '公开队伍' : '仅邀请加入'}}</text>
          </view>
          <text wx:if="{{team.isOwner}}" class="owner-badge">队长</text>
        </view>
        <view class="stats">
          <view class="stat"><text class="stat-value">{{team.activeCount}}/{{team.memberCount}}</text><text class="stat-label">今天学习</text></view>
          <view class="stat"><text class="stat-value">{{team.totalStudyCount}}</text><text class="stat-label">学习项</text></view>
          <view class="stat"><text class="stat-value">{{team.streak}}</text><text class="stat-label">连续活跃</text></view>
        </view>
        <view class="progress"><view style="width: {{team.memberCount ? team.activeCount / team.memberCount * 100 : 0}}%"></view></view>
        <text class="progress-note">今天已有 {{team.activeCount}} 位队友留下学习脚步</text>
      </view>

      <view class="card members-card">
        <view class="section-head"><view><text class="card-kicker">TODAY</text><text class="section-title">队友进度</text></view><text class="member-count">{{team.memberCount}} 人</text></view>
        <view wx:for="{{team.members}}" wx:key="memberId" class="member {{item.isMe ? 'is-me' : ''}}">
          <text class="avatar">{{item.avatar}}</text>
          <view class="member-copy">
            <view class="name-line"><text class="member-name">{{item.name}}</text><text wx:if="{{item.isMe}}" class="you-badge">你</text><text wx:if="{{item.isOwner}}" class="captain">队长</text></view>
            <text class="member-detail">今天 {{item.studyCount}} 项{{item.cheersReceived ? ' · 收到 ' + item.cheersReceived + ' 次加油' : ''}}</text>
          </view>
          <text wx:if="{{item.isMe}}" class="state {{item.completed ? 'done' : ''}}">{{item.completed ? '完成 ✓' : '学习中'}}</text>
          <button wx:else class="cheer {{item.cheeredByMe ? 'sent' : ''}}" data-id="{{item.memberId}}" disabled="{{busy || item.cheeredByMe}}" bindtap="cheer">{{item.cheeredByMe ? '已加油' : '加油'}}</button>
        </view>
      </view>

      <view class="invite-ticket">
        <view class="ticket-copy"><text class="card-kicker warm">INVITE CODE</text><text class="invite-code">{{team.inviteCode}}</text><text class="ticket-note">分享给想一起坚持的人</text></view>
        <view class="invite-actions"><button class="ghost compact" bindtap="copyInvite">复制</button><button class="primary compact" open-type="share">微信邀请</button></view>
      </view>

      <view class="manage-row">
        <button wx:if="{{team.isOwner}}" class="manage-button" bindtap="editTeam">队伍设置</button>
        <button wx:if="{{team.isOwner}}" class="manage-button" disabled="{{busy}}" bindtap="regenerateInvite">换邀请码</button>
        <button class="manage-button danger-text" disabled="{{busy}}" bindtap="leaveTeam">退出队伍</button>
      </view>

      <view wx:if="{{editing}}" class="card edit-card">
        <view class="section-head"><text class="section-title">队伍设置</text><button class="close-edit" bindtap="cancelEdit">×</button></view>
        <label class="field-label">队伍名称</label>
        <input class="input" value="{{draft.name}}" maxlength="20" placeholder="队伍名称" bindinput="inputName" />
        <label class="field-label options-label">队伍偏好</label>
        <view class="picker-row"><picker range="{{targets}}" value="{{targetIndex}}" bindchange="changeTarget"><view class="picker">目标 {{draft.targetLevel}}⌄</view></picker><picker range="{{emojis}}" value="{{emojiIndex}}" bindchange="changeEmoji"><view class="picker">{{draft.emoji}} 图标⌄</view></picker><picker range="{{visibilities}}" value="{{visibilityIndex}}" bindchange="changeVisibility"><view class="picker">{{draft.visibility === 'public' ? '公开' : '仅邀请'}}⌄</view></picker></view>
        <button class="primary" disabled="{{busy || draft.name.length < 2}}" bindtap="saveTeam">保存设置</button>
      </view>
    </block>

    <block wx:elif="{{auth.signedIn}}">
      <view class="card create-card">
        <view class="section-head create-head"><view><text class="card-kicker">CREATE A TEAM</text><text class="section-title large">创建自己的学习小队</text></view><text class="create-emoji">{{draft.emoji}}</text></view>
        <text class="detail first-detail">最多 6 人。公开队伍会出现在广场，仅邀请队伍需要邀请码。</text>
        <label class="field-label">你的队友昵称</label>
        <input class="input" value="{{nickname}}" maxlength="20" placeholder="例如：每天背十个" bindinput="inputNickname" />
        <label class="field-label">队伍名称</label>
        <input class="input" value="{{draft.name}}" maxlength="20" placeholder="例如：N3 每日打卡" bindinput="inputName" />
        <view class="picker-row"><picker range="{{targets}}" value="{{targetIndex}}" bindchange="changeTarget"><view class="picker">目标 {{draft.targetLevel}}⌄</view></picker><picker range="{{emojis}}" value="{{emojiIndex}}" bindchange="changeEmoji"><view class="picker">{{draft.emoji}} 图标⌄</view></picker><picker range="{{visibilities}}" value="{{visibilityIndex}}" bindchange="changeVisibility"><view class="picker">{{draft.visibility === 'public' ? '公开' : '仅邀请'}}⌄</view></picker></view>
        <button class="primary" loading="{{busy}}" disabled="{{busy || draft.name.length < 2 || !nickname.length}}" bindtap="createTeam">创建队伍</button>
      </view>

      <view class="join-ticket">
        <view class="join-icon">✦</view>
        <view class="join-copy"><text class="section-title small">已经收到邀请？</text><text class="detail">输入队友发来的 8 位邀请码</text></view>
        <view class="join-form"><input class="input code-input" value="{{inviteCode}}" maxlength="8" placeholder="邀请码" bindinput="inputInvite" /><button class="secondary compact" loading="{{busy}}" disabled="{{busy || inviteCode.length !== 8 || !nickname.length}}" bindtap="joinTeam">加入</button></view>
      </view>

      <view class="plaza-heading"><view><text class="card-kicker">DISCOVER</text><text class="plaza-title">组队广场</text></view><text class="plaza-tip">公开队伍</text></view>
      <view wx:if="{{!plaza.length}}" class="card empty-card plaza-empty"><view class="empty-icon">🌿</view><text class="section-title small">这里还很安静</text><text class="detail">创建第一支公开队伍，等同路的人来加入。</text></view>
      <view wx:for="{{plaza}}" wx:key="id" class="card plaza-item">
        <text class="plaza-emoji">{{item.emoji}}</text>
        <view class="plaza-copy"><text class="member-name">{{item.name}}</text><text class="member-detail">{{item.targetLevel}} · {{item.memberCount}}/{{item.maxMembers}} 人</text><text class="plaza-activity">今天 {{item.activeCount}} 人学习 · 连续 {{item.streak}} 天</text></view>
        <view class="plaza-actions"><button class="secondary compact" data-id="{{item.id}}" disabled="{{busy || !nickname.length}}" bindtap="joinTeam">加入</button><button class="report" data-id="{{item.id}}" disabled="{{busy}}" bindtap="reportTeam">举报</button></view>
      </view>
    </block>

    <view wx:if="{{result}}" class="result"><text class="result-dot"></text><text>{{result}}</text></view>
  </view>
</scroll-view>
