<view wx:if="{{sharedDaily}}" class="page">
  <view class="hero">
    <text class="eyebrow">DAILY STUDY</text>
    <text class="title">今日学习</text>
    <text class="subtitle">朋友今天完成了 {{sharedDaily.completed}} 个单词</text>
  </view>
  <view class="card empty-card">
    <text class="empty-title">{{sharedDaily.completed}} / {{sharedDaily.planned}} 个单词</text>
    <text class="empty-text">收集日 · 每天学一点日语</text>
  </view>
</view>

<scroll-view wx:else class="page" scroll-y>
  <view class="hero">
    <text class="eyebrow">WORD STUDY · 离线可用</text>
    <text class="title">今天学一点</text>
    <text class="subtitle">按自己的节奏收集，答题后自动保存在本机</text>
  </view>

  <view class="card status-card">
    <view class="status-row">
      <text class="label">本地库</text>
      <text class="status {{status.ready ? 'ready' : 'idle'}}">{{statusText}}</text>
    </view>
    <text class="detail">{{detailText}}</text>
  </view>

  <button class="primary" loading="{{busy}}" disabled="{{busy || status.ready}}" bindtap="handleInit">初始化本地库</button>

  <view wx:if="{{status.ready}}">
    <view class="filter-row">
      <text class="filter-label">今日范围</text>
      <picker mode="selector" range="{{levels}}" value="{{levelIndex}}" bindchange="handleLevelChange">
        <view class="picker">{{selectedLevel || '全部 JLPT'}} ˅</view>
      </picker>
    </view>
    <view class="filter-row">
      <text class="filter-label">学习方向</text>
      <picker mode="selector" range="{{directions}}" value="{{directionIndex}}" bindchange="handleDirectionChange">
        <view class="picker">{{directions[directionIndex]}} ˅</view>
      </picker>
    </view>

    <view class="stats card">
      <view class="stat"><text class="stat-value">{{stats.completed}}/{{stats.planned}}</text><text class="stat-label">今日完成</text></view>
      <view class="stat"><text class="stat-value">{{stats.remaining}}</text><text class="stat-label">还剩</text></view>
      <view class="stat"><text class="stat-value">{{stats.dueTotal}}</text><text class="stat-label">到期</text></view>
      <view wx:if="{{stats.reliefTotal}}" class="stat"><text class="stat-value">{{stats.reliefCompleted}}/{{stats.reliefTotal}}</text><text class="stat-label">昨日减负</text></view>
    </view>

    <!-- 混合模式的插播卡：盖在单词卡上面，答完清掉就接着背词。
         三种卡出的都是网页那同一副牌（同一份进度表、同一套 FSRS），在哪边答的都算数。 -->
    <view wx:if="{{interleave}}" class="card study-card interleave interleave-{{interleave.kind}}">
      <view wx:if="{{interleave.kind !== 'kanji'}}" class="card-meta">
        <text>{{interleave.kind === 'grammar' ? '插播 · 语法' : '插播 · 辨析卡'}}</text>
        <text>{{interleave.kind === 'grammar' ? interleave.card.level : interleave.card.label}}</text>
      </view>

      <!-- 语法：题面是句型，答案是接续 + 中文意 -->
      <block wx:if="{{interleave.kind === 'grammar'}}">
        <text class="meaning">{{interleave.card.question}}</text>
        <button wx:if="{{!interleaveRevealed}}" class="reveal" bindtap="revealInterleave">显示答案</button>
        <view wx:else class="answer">
          <text class="kanji">{{interleave.card.pattern}}</text>
          <text class="kana">{{interleave.card.formation}}</text>
          <text class="grammar-meaning">{{interleave.card.meaning}}</text>
          <view wx:if="{{interleave.card.exampleJp}}" class="example">
            <text class="example-jp">{{interleave.card.exampleJp}}</text>
            <text class="example-meaning">{{interleave.card.exampleMeaning}}</text>
          </view>
        </view>
      </block>

      <!-- 单独汉字：一个字的读音 + 什么时候读它 + 例词 -->
      <block wx:elif="{{interleave.kind === 'kanji'}}">
        <block wx:if="{{interleave.card.question}}">
          <view wx:if="{{!interleaveRevealed}}" class="kanji-match-progress">
            <text>已连 <text class="kanji-match-count">{{kanjiMatchCount}}</text> / {{kanjiWordRows.length}}</text>
            <view class="kanji-progress-track"><view class="kanji-progress-fill" style="width:{{kanjiMatchPercent}}%"></view></view>
          </view>
          <view class="kanji-match-labels"><text>词语 · 含「{{interleave.card.char}}」</text><text>读音选项</text></view>
          <view class="kanji-match-board">
            <view class="kanji-match-column">
              <view wx:for="{{kanjiWordRows}}" wx:key="index" class="kanji-match-cell {{item.selected ? 'picked' : ''}} {{item.paired ? 'paired' : ''}}" data-index="{{index}}" catchtap="selectKanjiWord">
                <text class="kanji-match-word">{{item.word}}</text>
                <text wx:if="{{interleaveRevealed}}" class="kanji-match-kana">{{item.wordKana}}</text>
                <text class="kanji-match-meaning">{{item.meaning}}</text>
              </view>
            </view>
            <view class="kanji-match-gutter">
              <view wx:for="{{kanjiConnections}}" wx:key="index" class="kanji-match-line {{item.kind}}" style="{{item.style}}"></view>
            </view>
            <view class="kanji-match-column">
              <view wx:for="{{kanjiReadingRows}}" wx:key="index" class="kanji-match-cell kanji-reading-cell {{item.paired ? 'paired' : ''}} {{item.correct ? 'correct' : ''}} {{selectedKanjiWord !== null ? 'available' : ''}}" data-index="{{index}}" catchtap="selectKanjiReading">
                <text class="kanji-match-word">{{item.reading}}</text>
              </view>
            </view>
          </view>
          <text wx:if="{{!interleaveRevealed}}" class="kanji-question-cue">已连好的词可以重新选择</text>
          <text wx:else class="kanji-question-cue">绿色线是正确答案，红色线是你原来的错误连线</text>
        </block>
        <text wx:else class="kanji-char">{{interleave.card.char}}</text>
        <view wx:if="{{!interleaveRevealed && interleave.card.question}}" class="kanji-match-actions">
          <button wx:if="{{kanjiMatchCount}}" class="kanji-clear" bindtap="clearKanjiConnections">清空</button>
          <button class="reveal" bindtap="revealInterleave">{{kanjiMatchComplete ? '核对连线' : '显示答案'}}</button>
        </view>
        <button wx:elif="{{!interleaveRevealed}}" class="reveal" bindtap="revealInterleave">显示读音</button>
        <view wx:else class="answer">
          <text wx:if="{{interleave.card.on.length}}" class="kana">音读：{{interleave.card.on}}</text>
          <text wx:if="{{interleave.card.kun.length}}" class="kana">训读：{{interleave.card.kun}}</text>
          <view wx:for="{{interleave.card.usage}}" wx:key="base" class="usage-row">
            <text class="usage-base">{{item.base}}</text><text class="usage-note">{{item.note}}</text>
          </view>
          <view wx:for="{{interleave.card.examples}}" wx:key="wordId" class="example">
            <text class="example-jp">{{item.kanji || item.kana}}（{{item.kana}}）</text>
            <text class="example-meaning">{{item.meaning}}</text>
          </view>
        </view>
      </block>

      <!-- 辨析 Anki 卡：正面回想词间区别，翻面查看手写辨析后自评。 -->
      <block wx:else>
        <view wx:if="{{!interleaveRevealed}}" class="distinction-front">
          <text class="match-hint">先说出每个词的意思和常见搭配，想清楚它们不能互换的地方。</text>
          <view wx:for="{{interleave.card.members}}" wx:key="id" class="distinction-front-item">
            <view><text class="match-surface">{{item.surface}}</text><text class="match-kana">{{item.kana}}</text></view>
          </view>
          <button class="reveal" bindtap="revealInterleave">显示辨析</button>
        </view>
        <view wx:else class="answer">
          <view class="distinction-overview">
            <text class="distinction-overview-title">判断要点</text>
            <text class="distinction-overview-text">{{interleave.card.overview}}</text>
          </view>
          <view wx:for="{{interleave.card.members}}" wx:key="id" class="distinction-note-row">
            <view class="distinction-note-term"><text class="match-surface">{{item.surface}}</text><text class="match-kana">{{item.kana}}</text></view>
            <text class="match-note">{{item.note || '具体用法见上方总述。'}}</text>
          </view>
        </view>
      </block>

      <view wx:if="{{interleaveRevealed}}" class="answer-actions">
        <button class="answer-btn forgot" data-answer="forgot" bindtap="answerInterleaveCard" disabled="{{busy}}">忘记</button>
        <button class="answer-btn fuzzy" data-answer="fuzzy" bindtap="answerInterleaveCard" disabled="{{busy}}">模糊</button>
        <button class="answer-btn know" data-answer="know" bindtap="answerInterleaveCard" disabled="{{busy}}">认识</button>
        <button class="answer-btn forever" data-answer="known_forever" bindtap="answerInterleaveCard" disabled="{{busy}}">熟知</button>
      </view>
    </view>

    <view wx:if="{{card && !interleave}}" class="card study-card word-card" style="{{swipeStyle}}" bindtouchstart="wordTouchStart" bindtouchmove="wordTouchMove" bindtouchend="wordTouchEnd" bindtouchcancel="wordTouchEnd">
      <text wx:if="{{swipeStamp}}" class="swipe-stamp {{swipeStamp === '认识' ? 'good' : 'bad'}}">{{swipeStamp}}</text>
      <view class="card-meta"><text>{{card.relief ? '昨日减负' : modeLabel + ' · ' + (card.task_type === 'new' ? '新词' : '复习')}}</text><text>{{card.jlpt_level || '未分级'}}</text></view>
      <text class="meaning">{{card.prompt}}</text>

      <!-- 汉字读音卡：题面就把表记摆出来，只遮汉字对应的那几拍。
           中文母语者认得字，盲区在读音 —— 把汉字也藏起来等于考错了东西。 -->
      <view wx:if="{{direction === 'kanji' && !answerVisible}}" class="kanji-prompt">
        <text class="kanji">{{card.surface}}</text>
        <view class="reading-mask">
          <block wx:for="{{card.concealedReading}}" wx:key="index">
            <view wx:if="{{item.hidden}}" class="reading-blank"></view>
            <text wx:else class="reading-kana">{{item.text}}</text>
          </block>
        </view>
      </view>

      <button wx:if="{{!answerVisible}}" class="reveal" data-no-swipe="1" bindtap="handleReveal">
        {{direction === 'kanji' ? '显示读音' : '显示答案'}}
      </button>
      <view wx:if="{{answerVisible}}" class="answer revealed-answer">
        <text wx:if="{{direction !== 'reverse'}}" class="kanji">{{card.surface}}</text>
        <text wx:if="{{direction !== 'reverse'}}" class="kana">{{card.kana}}</text>
        <text wx:if="{{direction === 'reverse'}}" class="reverse-answer">{{card.answerText}}</text>
        <button class="audio-button" data-no-swipe="1" disabled="{{busy}}" bindtap="handleAudio">▶ 播放读音</button>
        <text wx:if="{{card.pos}}" class="pos">{{card.pos}}</text>
        <text wx:if="{{card.verb_type}}" class="word-meta">动词类型：{{card.verb_type}}</text>
        <text wx:if="{{card.wordOrigin}}" class="word-meta">词源：{{card.wordOrigin}}</text>
        <view wx:if="{{card.pitch}}" class="pitch-card">
          <text class="pitch-label">音高重音 {{card.pitch.accent === 0 ? '平板' : '核 ' + card.pitch.accent}}</text>
          <view class="pitch-line"><block wx:for="{{card.pitch.morae}}" wx:key="index"><text class="pitch-mora {{item.high ? 'high' : 'low'}}">{{item.text}}</text></block></view>
        </view>
        <view wx:if="{{card.example_jp}}" class="example">
          <text class="example-jp">{{card.example_jp}}</text>
          <view wx:if="{{card.exampleSegments.length}}" class="furigana-line"><block wx:for="{{card.exampleSegments}}" wx:key="index"><view class="furigana-token"><text wx:if="{{item.reading}}" class="furigana-reading">{{item.reading}}</text><text>{{item.text}}</text></view></block></view>
          <text class="example-meaning">{{card.example_meaning}}</text>
        </view>
        <view wx:if="{{card.dictionaryEntries.length}}" class="dictionary"><text class="dictionary-title">例句词典</text><view wx:for="{{card.dictionaryEntries}}" wx:key="entry_key" class="dictionary-row"><text class="dictionary-head">{{item.headword}} {{item.kana}}</text><text class="dictionary-meaning">{{item.meaning}}</text><text wx:if="{{item.usage_note}}" class="dictionary-note">{{item.usage_note}}</text></view></view>
        <view wx:if="{{card.confusions.length}}" class="distinction"><text class="distinction-title">辨析提示</text><view wx:for="{{card.confusions}}" wx:key="key" class="distinction-row"><text class="distinction-type">{{item.typeName}} · {{item.label}}</text><text class="distinction-hint">{{item.hint}}</text></view><navigator class="distinction-link" url="/pages/confusion/index">打开全部疑难辨析 →</navigator></view>
        <navigator wx:elif="{{confusionsLocked}}" class="distinction-link" data-no-swipe="1" url="/pages/confusion/index">疑难辨析 · Pro →</navigator>
        <view class="answer-actions">
          <button class="answer forgot" data-answer="forgot" data-no-swipe="1" loading="{{busy}}" disabled="{{busy}}" bindtap="handleAnswer">忘记</button>
          <button class="answer fuzzy" data-answer="fuzzy" data-no-swipe="1" loading="{{busy}}" disabled="{{busy}}" bindtap="handleAnswer">模糊</button>
          <button class="answer know" data-answer="know" data-no-swipe="1" loading="{{busy}}" disabled="{{busy}}" bindtap="handleAnswer">认识</button>
        </view>
        <view class="note-editor">
          <input value="{{noteDraft}}" data-no-swipe="1" placeholder="给这个词留一句笔记" bindinput="handleNoteInput" />
          <button class="note-button" data-no-swipe="1" disabled="{{busy}}" bindtap="handleSaveNote">保存笔记</button>
        </view>
      </view>
    </view>

    <view wx:elif="{{!interleave}}" class="card empty-card">
      <text class="empty-title">今天的计划完成了</text>
      <text class="empty-text">可以继续查词，或明天再来。</text>
      <button wx:if="{{stats.completed > 0}}" class="primary share-done" open-type="share">分享今日完成</button>
      <text wx:if="{{stats.completed > 0}}" class="share-hint">分享到朋友圈：点右上角「…」并选择「分享到朋友圈」</text>
    </view>

    <button class="undo" loading="{{busy}}" disabled="{{busy || (mode === 'mixed' && !undoKinds.length)}}" bindtap="handleUndo">撤销上一张</button>
    <view class="shortcut-row">
      <navigator class="shortcut" url="/pages/library/index">查词库</navigator>
      <navigator class="shortcut" url="/pages/modes/index">换模式</navigator>
      <navigator class="shortcut" url="/pages/team/index">组队学习</navigator>
    </view>
  </view>

  <view class="card result-card" wx:if="{{result}}">
    <text class="result-title">最近一次结果</text>
    <text class="result">{{result}}</text>
  </view>

  <view class="note">
    <text>学习记录默认保存在本机，绑定账号后可按你的操作同步。</text>
  </view>
</scroll-view>
