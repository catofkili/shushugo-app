page { background: #f4ead6; color: #3a2e22; }
.page { min-height: 100vh; padding: 38rpx 30rpx 76rpx; box-sizing: border-box; }
.hero { padding: 12rpx 8rpx 30rpx; }
.eyebrow { display: block; color: #69a840; font-size: 20rpx; letter-spacing: 2rpx; font-weight: 800; }
.title { display: block; margin-top: 12rpx; font-size: 50rpx; line-height: 1.15; font-weight: 900; }
.subtitle { display: block; margin-top: 12rpx; color: #806f5c; font-size: 23rpx; }
.card { margin-bottom: 22rpx; padding: 29rpx; border: 2rpx solid rgba(114,84,52,.08); border-radius: 28rpx; background: #fbf5e9; box-shadow: 0 10rpx 28rpx rgba(91,67,42,.07); }
.status-row, .filter-row, .card-meta { display: flex; align-items: center; justify-content: space-between; }
.label, .filter-label, .result-title { font-size: 23rpx; color: #8a7764; }
.status { font-size: 24rpx; font-weight: 800; }.status.ready { color: #5f983a; }.status.idle { color: #b06e2f; }
.detail, .result { display: block; margin-top: 13rpx; color: #675747; font-size: 22rpx; line-height: 1.6; word-break: break-all; }
button { margin: 16rpx 0; border-radius: 20rpx; font-size: 27rpx; line-height: 88rpx; font-weight: 750; }
.primary { color: #fff; background: #69a840; }.secondary { color: #557d38; background: #e5efd9; }
.ghost, .undo { color: #685b4d; background: transparent; border: 2rpx solid #ddcfbc; }
.filter-row { margin: 17rpx 4rpx; }.picker { padding: 12rpx 20rpx; color: #5f5143; background: #fbf5e9; border-radius: 16rpx; font-size: 23rpx; box-shadow: 0 4rpx 14rpx rgba(91,67,42,.06); }
.stats { display: flex; justify-content: space-around; padding: 24rpx 12rpx; }.stat { flex: 1; text-align: center; border-right: 2rpx solid #eadfcf; }.stat:last-child { border-right: 0; }
.stat-value, .stat-label { display: block; }.stat-value { color: #3a2e22; font-size: 36rpx; font-weight: 900; }.stat-label { margin-top: 5rpx; color: #a08d79; font-size: 20rpx; }
.share-done { margin: 28rpx 0 0; }.share-hint { display: block; margin-top: 10rpx; color: #8a7764; font-size: 20rpx; }
.study-card { padding: 32rpx; }.card-meta { color: #9b8875; font-size: 21rpx; }.meaning { display: block; margin-top: 38rpx; color: #3a2e22; font-size: 42rpx; line-height: 1.35; font-weight: 850; }
.reveal { margin-top: 42rpx; color: #4f7936; background: #e4efd8; }.answer { margin-top: 32rpx; }.kanji, .kana, .pos { display: block; }.kanji { color: #3a2e22; font-size: 62rpx; line-height: 1.15; font-weight: 900; }
.kanji-prompt { margin-top: 12rpx; text-align: center; }.reading-mask { margin-top: 14rpx; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8rpx; }.reading-blank { width: 52rpx; height: 26rpx; border-radius: 8rpx; border: 2rpx solid rgba(105,168,64,.5); background: rgba(105,168,64,.14); }.reading-kana { color: #5f983a; font-size: 31rpx; line-height: 1; }
.reverse-answer { display: block; color: #3a2e22; font-size: 36rpx; line-height: 1.4; font-weight: 800; }.kana { margin-top: 8rpx; color: #5f983a; font-size: 31rpx; }.audio-button { display: inline-block; margin: 18rpx 0 0; padding: 0 22rpx; color: #557d38; background: #e4efd8; font-size: 22rpx; line-height: 64rpx; }.pos { margin-top: 10rpx; color: #806f5c; font-size: 22rpx; }.word-meta { display: block; margin-top: 8rpx; color: #a08d79; font-size: 20rpx; }
.pitch-card { margin-top: 20rpx; padding: 16rpx 18rpx; border-radius: 16rpx; background: #f2eadc; }.pitch-label { display: block; color: #806f5c; font-size: 20rpx; }.pitch-line { display: flex; align-items: flex-end; gap: 8rpx; margin-top: 16rpx; }.pitch-mora { position: relative; display: inline-block; min-width: 28rpx; padding-top: 12rpx; color: #8a7764; text-align: center; font-size: 27rpx; }.pitch-mora.high { color: #5f983a; border-top: 4rpx solid #5f983a; }.pitch-mora.low { border-top: 4rpx solid #bfae9b; }.pitch-mora.high::after, .pitch-mora.low::after { content: ''; position: absolute; left: 50%; top: -8rpx; width: 8rpx; height: 8rpx; transform: translateX(-50%); border-radius: 50%; background: currentColor; }
.example { margin-top: 26rpx; padding: 21rpx; border-radius: 18rpx; background: #f5eddf; }.example-jp, .example-meaning { display: block; line-height: 1.6; }.example-jp { color: #55483c; font-size: 25rpx; }.furigana-line { display: flex; flex-wrap: wrap; margin-top: 8rpx; color: #806f5c; font-size: 22rpx; }.furigana-token { display: inline-flex; flex-direction: column; align-items: center; min-height: 42rpx; }.furigana-reading { min-height: 22rpx; color: #5f983a; font-size: 17rpx; line-height: 1; }.example-meaning { margin-top: 5rpx; color: #806f5c; font-size: 22rpx; }
.dictionary { margin-top: 20rpx; padding: 18rpx; border-radius: 16rpx; background: #fff8e7; }.dictionary-title { display: block; color: #9b6b21; font-size: 21rpx; font-weight: 800; }.dictionary-row { margin-top: 10rpx; }.dictionary-head, .dictionary-meaning, .dictionary-note { display: block; }.dictionary-head { color: #55483c; font-size: 22rpx; }.dictionary-meaning { margin-top: 3rpx; color: #675747; font-size: 22rpx; }.dictionary-note { margin-top: 3rpx; color: #9b8875; font-size: 19rpx; }
.distinction { margin-top: 20rpx; padding: 18rpx; border-radius: 16rpx; background: #eee9f4; }.distinction-title, .distinction-type, .distinction-hint { display: block; }.distinction-title { color: #745d93; font-size: 21rpx; font-weight: 800; }.distinction-row { margin-top: 10rpx; }.distinction-type { color: #65517f; font-size: 22rpx; }.distinction-hint { margin-top: 4rpx; color: #7b6b82; font-size: 20rpx; line-height: 1.45; }.distinction-link { display: block; margin-top: 12rpx; color: #745d93; font-size: 21rpx; }
.answer-actions { display: flex; gap: 12rpx; margin-top: 28rpx; }.answer-actions button { flex: 1; margin: 0; }.answer.forgot { color: #9c4a4a; background: #f8e5e3; }.answer.fuzzy { color: #926b21; background: #f8edce; }.answer.know { color: #4f7936; background: #e2efda; }
.note-editor { display: flex; gap: 12rpx; align-items: center; margin-top: 22rpx; }.note-editor input { flex: 1; height: 74rpx; padding: 0 18rpx; box-sizing: border-box; border: 2rpx solid #e1d5c5; border-radius: 14rpx; background: #fffaf1; font-size: 22rpx; }.note-button { width: 146rpx; margin: 0; color: #685b4d; background: #eee6da; font-size: 21rpx; line-height: 74rpx; }
.empty-card { padding: 44rpx 30rpx; text-align: center; }.empty-title, .empty-text { display: block; }.empty-title { color: #3a2e22; font-size: 33rpx; font-weight: 850; }.empty-text { margin-top: 13rpx; color: #806f5c; font-size: 23rpx; }.undo { margin: 4rpx 0 22rpx; line-height: 76rpx; font-size: 23rpx; }
.shortcut-row { display: flex; gap: 12rpx; margin-bottom: 16rpx; }.shortcut { flex: 1; padding: 20rpx 8rpx; border-radius: 16rpx; color: #557d38; background: #e5efd9; text-align: center; font-size: 22rpx; font-weight: 750; }.result-card { margin-top: 22rpx; }.result-title { display: block; font-weight: 800; color: #3a2e22; }.note { padding: 16rpx 8rpx; color: #a08d79; font-size: 21rpx; line-height: 1.6; }

/* 混合模式的插播卡。颜色区别于单词卡（网页那边也是琥珀 / 青绿分开的）。 */
.interleave{border-left:8rpx solid #cc9a3e}
.interleave-kanji{border-left-color:#5c813f}
.interleave-confusion{border-left-color:#8a6ea8}
.kanji-char{display:block;text-align:center;font-size:120rpx;font-weight:800;line-height:1.2;margin:20rpx 0}
.kanji-question-cue{display:block;margin:16rpx 0;text-align:center;color:#806f5c;font-size:24rpx;line-height:1.45}.kanji-match-labels{display:grid;grid-template-columns:minmax(0,1fr) 64rpx minmax(0,1fr);margin:18rpx 0 10rpx;color:#9b8875;font-size:20rpx;font-weight:800}.kanji-match-labels text:last-child{text-align:right}.kanji-match-board{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 64rpx minmax(0,1fr);align-items:stretch}.kanji-match-column{display:flex;min-width:0;flex-direction:column;gap:12rpx}.kanji-match-gutter{position:relative}.kanji-match-cell{position:relative;z-index:1;display:flex;min-width:0;min-height:100rpx;box-sizing:border-box;flex-direction:column;justify-content:center;padding:10rpx 12rpx;border:2rpx solid #e7dccb;border-radius:16rpx;background:#f5eddf}.kanji-match-cell.picked{border-color:#8cae6b;background:#e5efd9}.kanji-match-cell.paired{border-color:#bb9bcf;background:#f1e9f5}.kanji-match-cell.correct{border-color:#78a755;background:#e5efd9}.kanji-match-cell.available{cursor:pointer}.kanji-match-word{display:block;overflow:hidden;color:#55483c;font-size:27rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.kanji-match-kana{display:block;overflow:hidden;color:#5f983a;font-size:19rpx;text-overflow:ellipsis;white-space:nowrap}.kanji-match-meaning{display:block;overflow:hidden;margin-top:4rpx;color:#8a7764;font-size:18rpx;text-overflow:ellipsis;white-space:nowrap}.kanji-reading-cell{align-items:flex-end;text-align:right}.kanji-match-line{position:absolute;left:0;width:64rpx;height:5rpx;border-radius:8rpx;transform-origin:left center;pointer-events:none}.kanji-match-line.attempt{background:#9d7db4;opacity:.82}.kanji-match-line.correct{background:#6fa83e;opacity:.92}.kanji-match-line.wrong{background:#c87971;opacity:.82}
.grammar-meaning{display:block;margin-top:12rpx;font-size:28rpx;line-height:1.6}
.usage-row{margin-top:12rpx;padding:16rpx;border-radius:16rpx;background:#f5efe5}
.usage-base{font-weight:800;margin-right:12rpx}
.usage-note{color:#6f685f;font-size:24rpx}
.match-hint{display:block;margin:16rpx 0;color:#8a8177;font-size:24rpx}
.distinction-front{display:flex;flex-direction:column;gap:12rpx}
.match-body{display:flex;gap:16rpx}
.match-col{flex:1;display:flex;flex-direction:column;gap:12rpx}
.match-item{padding:18rpx;border-radius:18rpx;background:#f3ede3}
.match-item.picked{background:#dfeecf;font-weight:700}
.match-item.done{opacity:.45}
.match-surface{display:block;font-size:30rpx;font-weight:700}
.match-kana{display:block;color:#887d70;font-size:22rpx}
.match-prompt{display:block;font-size:26rpx;line-height:1.5}
.match-note{display:block;margin-top:6rpx;color:#6f685f;font-size:22rpx}

.kanji-match-progress{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:20rpx 4rpx 8rpx;color:#806f5c;font-size:21rpx}
.kanji-match-count{color:#745d93;font-weight:900}
.kanji-progress-track{width:150rpx;height:10rpx;overflow:hidden;border-radius:20rpx;background:#e5dfeb}
.kanji-progress-fill{height:100%;border-radius:20rpx;background:#9a7eb7}
.kanji-match-labels{display:flex;justify-content:space-between;gap:12rpx;margin:12rpx 4rpx 8rpx;color:#8a7764;font-size:20rpx;letter-spacing:.4rpx}
.kanji-match-cell{height:152rpx;min-height:152rpx;padding:10rpx 14rpx;border-radius:18rpx;background:linear-gradient(145deg,#fbf5e9,#f2eadd)}
.kanji-match-cell.picked{border-color:#9a7eb7;background:#eee5f4;box-shadow:0 4rpx 12rpx rgba(116,93,147,.12)}
.kanji-match-cell.paired{border-color:#b79bcf;background:#f1e9f5}
.kanji-reading-cell{align-items:flex-end}
.kanji-match-word{font-size:28rpx;line-height:1.25}
.kanji-match-kana{font-size:19rpx}
.kanji-match-meaning{display:-webkit-box;overflow:hidden;margin-top:4rpx;color:#806f5c;font-size:19rpx;line-height:1.25;white-space:normal;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.kanji-match-actions{display:flex;align-items:stretch;gap:12rpx;margin-top:22rpx}
.kanji-match-actions .reveal{flex:1;margin:0}
.kanji-match-actions .kanji-clear{width:144rpx;margin:0;color:#685b4d;background:#eee6da;font-size:23rpx;line-height:88rpx}
.kanji-question-cue{margin:12rpx 0;text-align:center;font-size:21rpx}
.distinction-front-item{padding:20rpx 18rpx;border:2rpx solid rgba(138,110,168,.16);border-radius:18rpx;background:#f3edf7}
.distinction-overview{margin-top:8rpx;padding:20rpx;border:2rpx solid rgba(138,110,168,.18);border-radius:20rpx;background:#eee8f5}
.distinction-overview-title{display:block;color:#745d93;font-size:20rpx;font-weight:800;letter-spacing:1rpx}
.distinction-overview-text{display:block;margin-top:7rpx;color:#55483c;font-size:24rpx;line-height:1.55}
.distinction-note-row{display:grid;grid-template-columns:180rpx minmax(0,1fr);gap:16rpx;margin-top:12rpx;padding:18rpx;border:2rpx solid rgba(114,84,52,.08);border-radius:18rpx;background:#fbf5e9}
.distinction-note-term{min-width:0}
.distinction-note-term .match-surface{font-size:26rpx;line-height:1.35;word-break:break-all}
.distinction-note-term .match-kana{font-size:20rpx;word-break:break-all}
.distinction-note-row .match-note{align-self:center;margin:0;color:#675747;font-size:22rpx;line-height:1.55}

.word-card{position:relative;will-change:transform}
.revealed-answer{animation:wordReveal .24s ease-out both}
.swipe-stamp{position:absolute;right:30rpx;top:85rpx;z-index:2;padding:10rpx 22rpx;border:4rpx solid currentColor;border-radius:14rpx;font-size:36rpx;font-weight:900;transform:rotate(9deg);pointer-events:none}
.swipe-stamp.good{color:#6fa83e}.swipe-stamp.bad{color:#bb7972}
@keyframes wordReveal{from{opacity:0;transform:rotateY(-12deg) translateY(10rpx)}to{opacity:1;transform:rotateY(0) translateY(0)}}
