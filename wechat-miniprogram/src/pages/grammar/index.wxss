page { background: #f4f6fb; color: #172033; }
.page { min-height: 100vh; padding: 42rpx 36rpx 76rpx; box-sizing: border-box; }
.hero { padding: 12rpx 4rpx 28rpx; }
.back { color: #4c6fff; font-size: 24rpx; }
.eyebrow { display: block; margin-top: 22rpx; color: #4c6fff; font-size: 21rpx; letter-spacing: 3rpx; font-weight: 800; }
.title { display: block; margin-top: 10rpx; font-size: 52rpx; font-weight: 800; }
.subtitle { display: block; margin-top: 12rpx; color: #667085; font-size: 24rpx; line-height: 1.55; }
.immersive-button { margin: 22rpx 0 0; color: #fff; background: #4c6fff; line-height: 72rpx; font-size: 23rpx; }.immersive { min-height: 560rpx; padding: 34rpx 30rpx; background: #303737; color: #fff; }.immersive-kicker { display: block; color: #a8c6b5; font-size: 20rpx; letter-spacing: 2rpx; }.immersive-pattern { display: block; margin-top: 70rpx; color: #f7e4b1; font-size: 43rpx; font-weight: 800; }.immersive-jp { display: block; margin-top: 50rpx; color: #fff; font-size: 31rpx; line-height: 1.7; }.immersive-furigana { display: block; margin-top: 12rpx; color: #a8c6b5; font-size: 20rpx; }.immersive-cn { display: block; margin-top: 18rpx; color: #d5ded9; font-size: 24rpx; line-height: 1.6; }.immersive-meaning { display: block; margin-top: 14rpx; color: #a8c6b5; font-size: 22rpx; }.next-immersive { margin-top: 42rpx; color: #243b80; background: #e8f1e7; line-height: 76rpx; font-size: 24rpx; }
.card { margin-bottom: 18rpx; padding: 26rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(23,32,51,.06); }
.summary { display: flex; gap: 10rpx; overflow-x: auto; }
.summary-item { min-width: 100rpx; padding: 14rpx 16rpx; border-radius: 16rpx; background: #eef2ff; color: #344054; text-align: center; font-size: 23rpx; }
.summary-item text { display: block; }
.summary-item text + text { margin-top: 6rpx; color: #4c6fff; font-weight: 800; }
.filters { display: flex; gap: 12rpx; align-items: center; margin-bottom: 18rpx; }
.filters input { flex: 1; height: 76rpx; padding: 0 18rpx; box-sizing: border-box; background: #fff; border-radius: 16rpx; font-size: 24rpx; }
.picker { padding: 22rpx 18rpx; border-radius: 16rpx; background: #fff; color: #344054; font-size: 23rpx; }
.row-top, .detail-head { display: flex; justify-content: space-between; align-items: center; }
.level { color: #4c6fff; font-size: 22rpx; font-weight: 800; }
.order { color: #98a2b3; font-size: 22rpx; }
.known { color: #16835b; font-size: 22rpx; }
.favorite { color: #d08b00; font-size: 26rpx; }
.row-pattern { display: block; margin-top: 14rpx; font-size: 31rpx; font-weight: 800; }
.row-meaning { display: block; margin-top: 8rpx; color: #475467; font-size: 24rpx; }
.row-example { display: block; margin-top: 12rpx; color: #98a2b3; font-size: 22rpx; }
.detail { border: 2rpx solid #d8defa; }
.pattern { display: block; margin-top: 18rpx; color: #172033; font-size: 42rpx; line-height: 1.35; font-weight: 800; }
.meaning { display: block; margin-top: 12rpx; color: #344054; font-size: 28rpx; }
.formation, .notes { display: block; margin-top: 14rpx; color: #667085; font-size: 23rpx; line-height: 1.6; }
.example { margin-top: 22rpx; padding: 18rpx; border-radius: 16rpx; background: #f8f9fc; }
.jp, .cn { display: block; line-height: 1.6; }.jp { font-size: 26rpx; }.cn { margin-top: 4rpx; color: #667085; font-size: 23rpx; }
.actions { display: flex; gap: 12rpx; margin-top: 22rpx; }.actions button { flex: 1; margin: 0; color: #243b80; background: #eef2ff; font-size: 23rpx; }
.empty, .error { color: #667085; text-align: center; font-size: 24rpx; }.error { color: #b42318; }
