page { background: #f4ead6; color: #3a2e22; }.page { min-height: 100vh; padding: 38rpx 30rpx 76rpx; box-sizing: border-box; }.hero { padding: 12rpx 8rpx 28rpx; }.eyebrow { display: block; color: #69a840; font-size: 20rpx; letter-spacing: 2rpx; font-weight: 800; }.title { display: block; margin-top: 10rpx; font-size: 49rpx; font-weight: 900; }.subtitle { display: block; margin-top: 11rpx; color: #806f5c; font-size: 23rpx; line-height: 1.55; }
.immersive-button { margin: 20rpx 0 0; color: #fff; background: #69a840; border-radius: 18rpx; line-height: 72rpx; font-size: 22rpx; font-weight: 750; }.immersive { min-height: 560rpx; padding: 34rpx 30rpx; background: #35453a; color: #fff; }.immersive-kicker { display: block; color: #c8dda9; font-size: 20rpx; letter-spacing: 2rpx; }.immersive-pattern { display: block; margin-top: 70rpx; color: #f5dfaa; font-size: 43rpx; font-weight: 850; }.immersive-jp { display: block; margin-top: 50rpx; color: #fff; font-size: 31rpx; line-height: 1.7; }.immersive-furigana { display: block; margin-top: 12rpx; color: #bad2c0; font-size: 20rpx; }.immersive-cn { display: block; margin-top: 18rpx; color: #dce5df; font-size: 24rpx; line-height: 1.6; }.immersive-meaning { display: block; margin-top: 14rpx; color: #bad2c0; font-size: 22rpx; }.next-immersive { margin-top: 42rpx; color: #4f7936; background: #e8f1dc; line-height: 76rpx; font-size: 24rpx; }
.card { margin-bottom: 18rpx; padding: 26rpx; border: 2rpx solid rgba(114,84,52,.08); border-radius: 24rpx; background: #fbf5e9; box-shadow: 0 8rpx 24rpx rgba(91,67,42,.07); }.summary { display: flex; gap: 10rpx; overflow-x: auto; }.summary-item { min-width: 100rpx; padding: 14rpx 16rpx; border-radius: 16rpx; background: #e5efd9; color: #675747; text-align: center; font-size: 22rpx; }.summary-item text { display: block; }.summary-item text + text { margin-top: 6rpx; color: #5f983a; font-weight: 850; }
.filters { display: flex; gap: 12rpx; align-items: center; margin-bottom: 18rpx; }.filters input { flex: 1; height: 76rpx; padding: 0 18rpx; box-sizing: border-box; background: #fbf5e9; border-radius: 16rpx; font-size: 23rpx; }.picker { padding: 22rpx 18rpx; border-radius: 16rpx; background: #fbf5e9; color: #675747; font-size: 22rpx; }.row-top, .detail-head { display: flex; justify-content: space-between; align-items: center; }.level { color: #5f983a; font-size: 21rpx; font-weight: 850; }.order { color: #a08d79; font-size: 21rpx; }.known { color: #5f983a; font-size: 21rpx; }.favorite { color: #c58c24; font-size: 26rpx; }
.row-pattern { display: block; margin-top: 14rpx; font-size: 30rpx; font-weight: 850; }.row-meaning { display: block; margin-top: 8rpx; color: #675747; font-size: 23rpx; }.row-example { display: block; margin-top: 12rpx; color: #9b8875; font-size: 21rpx; }.detail { border: 2rpx solid #cdddbb; }.pattern { display: block; margin-top: 18rpx; color: #3a2e22; font-size: 41rpx; line-height: 1.35; font-weight: 850; }.meaning { display: block; margin-top: 12rpx; color: #55483c; font-size: 27rpx; }.formation, .notes { display: block; margin-top: 14rpx; color: #806f5c; font-size: 22rpx; line-height: 1.6; }.example { margin-top: 22rpx; padding: 18rpx; border-radius: 16rpx; background: #f2eadc; }.jp, .cn { display: block; line-height: 1.6; }.jp { font-size: 25rpx; }.cn { margin-top: 4rpx; color: #806f5c; font-size: 22rpx; }.actions { display: flex; gap: 12rpx; margin-top: 22rpx; }.actions button { flex: 1; margin: 0; color: #4f7936; background: #e5efd9; font-size: 22rpx; }.empty, .error { color: #806f5c; text-align: center; font-size: 23rpx; }.error { color: #a84e45; }
