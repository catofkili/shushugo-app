page { background: #f4f6fb; color: #172033; }.page { min-height: 100vh; padding: 42rpx 40rpx 72rpx; box-sizing: border-box; }.hero { padding: 10rpx 8rpx 34rpx; }.back { color: #4c6fff; font-size: 25rpx; }.title { display: block; margin-top: 28rpx; font-size: 52rpx; font-weight: 800; }.subtitle { display: block; margin-top: 10rpx; color: #667085; font-size: 24rpx; line-height: 1.5; }.card { margin-bottom: 20rpx; padding: 28rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 26rpx rgba(23,32,51,.05); }.spring { position: relative; overflow: hidden; background: linear-gradient(145deg,#eef4ff,#fff); }.kicker { color: #4c6fff; font-size: 20rpx; letter-spacing: 2rpx; }.spring-title { display: block; margin-top: 12rpx; color: #172033; font-size: 34rpx; font-weight: 800; }.spring-detail { display: block; width: 72%; margin-top: 10rpx; color: #667085; font-size: 22rpx; line-height: 1.5; }.spring-water { position: absolute; right: 34rpx; bottom: 25rpx; display: flex; align-items: center; justify-content: center; width: 130rpx; height: 130rpx; border-radius: 50%; color: #4c6fff; background: #dce7ff; font-size: 56rpx; }.section-title { color: #172033; font-size: 28rpx; font-weight: 750; }.map-row { margin-top: 20rpx; }.map-label { display: flex; justify-content: space-between; color: #475467; font-size: 23rpx; }.map-track { height: 14rpx; margin-top: 8rpx; border-radius: 10rpx; background: #eef0f3; overflow: hidden; }.map-fill { height: 100%; border-radius: 10rpx; background: #4c6fff; }.map-caption { display: block; margin-top: 6rpx; color: #98a2b3; font-size: 20rpx; }.row { display: flex; justify-content: space-between; align-items: center; }.more { color: #4c6fff; font-size: 22rpx; }.dex-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 18rpx; }.dex-item { display: flex; flex-direction: column; align-items: center; gap: 5rpx; width: 120rpx; padding: 14rpx 8rpx; border-radius: 16rpx; color: #475467; background: #f7f8fa; font-size: 20rpx; }.dex-item text:first-child { font-size: 36rpx; }.muted { color: #98a2b3; font-size: 22rpx; }
