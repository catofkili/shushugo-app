page { background: #f4ead6; color: #3a2e22; }
.page { min-height: 100vh; padding: 42rpx 40rpx 72rpx; box-sizing: border-box; }
.hero { padding: 10rpx 8rpx 34rpx; }.back { color: #69a840; font-size: 25rpx; }.title { display: block; margin-top: 28rpx; font-size: 52rpx; font-weight: 800; }.subtitle { display: block; margin-top: 10rpx; color: #806f5c; font-size: 25rpx; line-height: 1.5; }
.mode-card { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 18rpx; padding: 28rpx; border-radius: 24rpx; background: #fbf5e9; box-shadow: 0 10rpx 26rpx rgba(91,67,42,.07); border-left: 10rpx solid #d0d5dd; }.tone-blue { border-left-color: #69a840; }.tone-green { border-left-color: #43a46b; }.tone-red { border-left-color: #d95d58; }.tone-purple { border-left-color: #8c6dd7; }.tone-orange { border-left-color: #e89649; }
.mode-copy { flex: 1; }.mode-title, .mode-detail { display: block; }.mode-title { color: #3a2e22; font-size: 31rpx; font-weight: 750; }.mode-detail { margin-top: 8rpx; color: #806f5c; font-size: 22rpx; line-height: 1.5; }.start { flex: none; padding: 12rpx 18rpx; color: #69a840; background: #e5efd9; border-radius: 14rpx; font-size: 23rpx; }.note { margin: 28rpx 8rpx; color: #a08d79; font-size: 22rpx; line-height: 1.6; }
