page { background: #f4f6fb; color: #172033; }
.page { min-height: 100vh; padding: 42rpx 40rpx 72rpx; box-sizing: border-box; }
.hero { padding: 10rpx 8rpx 34rpx; }.back { color: #4c6fff; font-size: 25rpx; }.title { display: block; margin-top: 28rpx; font-size: 52rpx; font-weight: 800; }.subtitle { display: block; margin-top: 10rpx; color: #667085; font-size: 25rpx; line-height: 1.5; }
.mode-card { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 18rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 10rpx 26rpx rgba(23, 32, 51, .05); border-left: 10rpx solid #d0d5dd; }.tone-blue { border-left-color: #4c6fff; }.tone-green { border-left-color: #43a46b; }.tone-red { border-left-color: #d95d58; }.tone-purple { border-left-color: #8c6dd7; }.tone-orange { border-left-color: #e89649; }
.mode-copy { flex: 1; }.mode-title, .mode-detail { display: block; }.mode-title { color: #172033; font-size: 31rpx; font-weight: 750; }.mode-detail { margin-top: 8rpx; color: #667085; font-size: 22rpx; line-height: 1.5; }.start { flex: none; padding: 12rpx 18rpx; color: #4c6fff; background: #eef2ff; border-radius: 14rpx; font-size: 23rpx; }.note { margin: 28rpx 8rpx; color: #98a2b3; font-size: 22rpx; line-height: 1.6; }
