<scroll-view class="page" scroll-y>
  <view class="hero">
    <navigator class="back" open-type="navigateBack">‹ 返回学习</navigator>
    <text class="title">学习模式</text>
    <text class="subtitle">按今天的需要选择练习方式</text>
  </view>
  <view wx:if="{{error}}" class="note">{{error}}</view>
  <view wx:for="{{modes}}" wx:key="id" class="mode-card tone-{{item.tone}}">
    <view class="mode-copy">
      <text class="mode-title">{{item.title}}<text wx:if="{{item.count}}" class="mode-count"> · 还能练 {{item.count}}</text></text>
      <text class="mode-detail">{{item.subtitle}} · {{item.detail}}</text>
    </view>
    <button class="start" data-mode="{{item.id}}" bindtap="startMode">开始 →</button>
  </view>
  <view class="note">错题本和自选清单不占今日计划；收藏和笔记都保存在本机，并和网页 / App 同步。</view>
</scroll-view>
