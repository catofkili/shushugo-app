page { background: #f4ead6; color: #3a2e22; }.page { min-height: 100vh; padding: 42rpx 40rpx 72rpx; box-sizing: border-box; }.hero { padding: 10rpx 8rpx 34rpx; }.back { color: #69a840; font-size: 25rpx; }.title { display: block; margin-top: 28rpx; font-size: 52rpx; font-weight: 800; }.subtitle { display: block; margin-top: 10rpx; color: #806f5c; font-size: 24rpx; line-height: 1.5; }.card { margin-bottom: 18rpx; padding: 26rpx; border-radius: 24rpx; background: #fbf5e9; box-shadow: 0 10rpx 26rpx rgba(91,67,42,.07); }.search-row { display: flex; gap: 12rpx; }.search { flex: 1; height: 78rpx; padding: 0 18rpx; box-sizing: border-box; border-radius: 14rpx; background: #fbf5e9; font-size: 24rpx; }.search-row button { width: 128rpx; margin: 0; color: #fff; background: #69a840; line-height: 78rpx; font-size: 23rpx; }.picker { margin: 16rpx 0; padding: 18rpx; border-radius: 14rpx; background: #fbf5e9; color: #55483c; font-size: 24rpx; }.summary { color: #806f5c; font-size: 23rpx; }.summary-number { color: #69a840; font-size: 40rpx; font-weight: 800; }.group { padding: 26rpx; }.group-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12rpx; }.type { display: block; color: #69a840; font-size: 21rpx; font-weight: 700; }.group-title { display: block; margin-top: 6rpx; color: #3a2e22; font-size: 31rpx; font-weight: 750; }.mastered { flex: none; margin: 0; padding: 0 12rpx; color: #69a840; background: #e5efd9; line-height: 58rpx; font-size: 20rpx; }.mastered.on { color: #20733b; background: #d9f2dd; }.hint { display: block; margin-top: 14rpx; color: #806f5c; font-size: 22rpx; line-height: 1.5; }.member { margin-top: 16rpx; padding: 16rpx; border-radius: 14rpx; background: #f5eddf; }.member-main { display: flex; align-items: baseline; gap: 10rpx; }.member-kanji { color: #3a2e22; font-size: 30rpx; font-weight: 750; }.member-kana { color: #69a840; font-size: 22rpx; }.member-level { margin-left: auto; color: #a08d79; font-size: 19rpx; }.member-meaning, .member-example { display: block; margin-top: 6rpx; }.member-meaning { color: #55483c; font-size: 23rpx; }.member-example { color: #806f5c; font-size: 21rpx; line-height: 1.45; }.load-more { margin: 10rpx 0 30rpx; color: #69a840; background: #fbf5e9; font-size: 23rpx; }.empty { color: #806f5c; text-align: center; }.error { margin-top: 18rpx; color: #b42318; font-size: 22rpx; }

.paywall { text-align: center; }
.paywall-title { display: block; font-size: 34rpx; font-weight: 800; }
.paywall-body { display: block; margin: 16rpx 0 24rpx; color: #806f5c; font-size: 25rpx; line-height: 1.6; }
.paywall .primary { color: #fff; background: #69a840; border-radius: 20rpx; }
