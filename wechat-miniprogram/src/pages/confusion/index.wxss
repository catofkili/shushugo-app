page { background: #f4f6fb; color: #172033; }.page { min-height: 100vh; padding: 42rpx 40rpx 72rpx; box-sizing: border-box; }.hero { padding: 10rpx 8rpx 34rpx; }.back { color: #4c6fff; font-size: 25rpx; }.title { display: block; margin-top: 28rpx; font-size: 52rpx; font-weight: 800; }.subtitle { display: block; margin-top: 10rpx; color: #667085; font-size: 24rpx; line-height: 1.5; }.card { margin-bottom: 18rpx; padding: 26rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 10rpx 26rpx rgba(23,32,51,.05); }.search-row { display: flex; gap: 12rpx; }.search { flex: 1; height: 78rpx; padding: 0 18rpx; box-sizing: border-box; border-radius: 14rpx; background: #fff; font-size: 24rpx; }.search-row button { width: 128rpx; margin: 0; color: #fff; background: #4c6fff; line-height: 78rpx; font-size: 23rpx; }.picker { margin: 16rpx 0; padding: 18rpx; border-radius: 14rpx; background: #fff; color: #344054; font-size: 24rpx; }.summary { color: #667085; font-size: 23rpx; }.summary-number { color: #4c6fff; font-size: 40rpx; font-weight: 800; }.group { padding: 26rpx; }.group-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12rpx; }.type { display: block; color: #4c6fff; font-size: 21rpx; font-weight: 700; }.group-title { display: block; margin-top: 6rpx; color: #172033; font-size: 31rpx; font-weight: 750; }.mastered { flex: none; margin: 0; padding: 0 12rpx; color: #4c6fff; background: #eef2ff; line-height: 58rpx; font-size: 20rpx; }.mastered.on { color: #20733b; background: #d9f2dd; }.hint { display: block; margin-top: 14rpx; color: #667085; font-size: 22rpx; line-height: 1.5; }.member { margin-top: 16rpx; padding: 16rpx; border-radius: 14rpx; background: #f7f8fa; }.member-main { display: flex; align-items: baseline; gap: 10rpx; }.member-kanji { color: #172033; font-size: 30rpx; font-weight: 750; }.member-kana { color: #4c6fff; font-size: 22rpx; }.member-level { margin-left: auto; color: #98a2b3; font-size: 19rpx; }.member-meaning, .member-example { display: block; margin-top: 6rpx; }.member-meaning { color: #344054; font-size: 23rpx; }.member-example { color: #667085; font-size: 21rpx; line-height: 1.45; }.load-more { margin: 10rpx 0 30rpx; color: #4c6fff; background: #fff; font-size: 23rpx; }.empty { color: #667085; text-align: center; }.error { margin-top: 18rpx; color: #b42318; font-size: 22rpx; }
