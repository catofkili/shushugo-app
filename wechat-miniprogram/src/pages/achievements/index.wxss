page { background: #f4f6fb; color: #172033; }.page { min-height: 100vh; padding: 42rpx 40rpx 72rpx; box-sizing: border-box; }.hero { padding: 10rpx 8rpx 34rpx; }.back { color: #4c6fff; font-size: 25rpx; }.title { display: block; margin-top: 28rpx; font-size: 52rpx; font-weight: 800; }.subtitle { display: block; margin-top: 10rpx; color: #667085; font-size: 24rpx; }.card { margin-bottom: 18rpx; padding: 26rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 10rpx 26rpx rgba(23,32,51,.05); }.score { color: #667085; font-size: 23rpx; text-align: center; }.score-number { color: #4c6fff; font-size: 44rpx; font-weight: 800; }.picker { margin-bottom: 18rpx; padding: 18rpx; border-radius: 14rpx; color: #344054; background: #fff; font-size: 24rpx; }.achievement { display: flex; gap: 18rpx; align-items: flex-start; }.achievement.unlocked { border-left: 8rpx solid #4c6fff; padding-left: 18rpx; }.emoji { font-size: 40rpx; }.achievement-copy { flex: 1; }.achievement-title { display: flex; justify-content: space-between; align-items: baseline; color: #172033; font-size: 28rpx; font-weight: 750; }.category { color: #98a2b3; font-size: 19rpx; font-weight: 400; }.description { display: block; margin-top: 8rpx; color: #667085; font-size: 22rpx; line-height: 1.45; }.progress { height: 10rpx; margin-top: 14rpx; border-radius: 8rpx; background: #eef0f3; overflow: hidden; }.progress-fill { height: 100%; border-radius: 8rpx; background: #4c6fff; }.progress-text { display: block; margin-top: 6rpx; color: #98a2b3; font-size: 19rpx; }
