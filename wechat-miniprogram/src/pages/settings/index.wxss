page { background: #f4f6fb; color: #172033; }
.page { min-height: 100vh; padding: 42rpx 40rpx 72rpx; box-sizing: border-box; }
.hero { padding: 10rpx 8rpx 34rpx; }
.back { color: #4c6fff; font-size: 25rpx; }
.title { display: block; margin-top: 28rpx; font-size: 52rpx; font-weight: 800; }
.subtitle { display: block; margin-top: 10rpx; color: #667085; font-size: 24rpx; line-height: 1.5; }
.card { margin-bottom: 22rpx; padding: 30rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 26rpx rgba(23, 32, 51, .05); }
.row { display: flex; justify-content: space-between; align-items: center; }
.label, .detail { color: #667085; font-size: 25rpx; }
.value { color: #475467; font-size: 34rpx; font-weight: 800; }
.value.active { color: #16835b; }
.detail { display: block; margin-top: 14rpx; font-size: 23rpx; }
button { margin: 18rpx 0; border-radius: 20rpx; line-height: 92rpx; font-size: 28rpx; }
.primary { color: #fff; background: #4c6fff; }
.secondary { color: #243b80; background: #e9edff; }
.small { margin-bottom: 0; line-height: 76rpx; font-size: 24rpx; }
.result { color: #344054; line-height: 1.6; }
.maintenance-card { margin-top: 26rpx; }.section-title { display: block; color: #172033; font-size: 28rpx; font-weight: 750; }.ghost { color: #475467; background: transparent; border: 1rpx solid #d0d5dd; }
.notice { padding: 22rpx 8rpx; color: #98a2b3; font-size: 22rpx; line-height: 1.7; }
