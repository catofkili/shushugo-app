page { background: #f4ead6; color: #3a2e22; }.page { min-height: 100vh; padding: 38rpx 30rpx 76rpx; box-sizing: border-box; }.hero { padding: 12rpx 8rpx 30rpx; }.eyebrow { display: block; color: #69a840; font-size: 20rpx; letter-spacing: 2rpx; font-weight: 800; }.title { display: block; margin-top: 12rpx; font-size: 48rpx; font-weight: 900; }.subtitle { display: block; margin-top: 10rpx; color: #806f5c; font-size: 23rpx; line-height: 1.5; }
.card { margin-bottom: 20rpx; padding: 29rpx; border: 2rpx solid rgba(114,84,52,.08); border-radius: 28rpx; background: #fbf5e9; box-shadow: 0 10rpx 26rpx rgba(91,67,42,.07); }.row { display: flex; justify-content: space-between; align-items: center; }.label, .detail { color: #806f5c; font-size: 24rpx; }.value { color: #675747; font-size: 32rpx; font-weight: 900; }.value.active { color: #5f983a; }.detail { display: block; margin-top: 13rpx; font-size: 22rpx; line-height: 1.6; }
button { margin: 17rpx 0; border-radius: 20rpx; line-height: 88rpx; font-size: 27rpx; font-weight: 750; }.primary { color: #fff; background: #69a840; }.secondary { color: #557d38; background: #e5efd9; }.small { margin-bottom: 0; line-height: 74rpx; font-size: 23rpx; }.ghost { color: #685b4d; background: transparent; border: 2rpx solid #ddcfbc; }.result { color: #55483c; line-height: 1.6; }.maintenance-card { margin-top: 24rpx; }.section-title { display: block; color: #3a2e22; font-size: 27rpx; font-weight: 850; }.notice { padding: 20rpx 8rpx; color: #a08d79; font-size: 21rpx; line-height: 1.7; }.legal-link { display: block; margin-top: 15rpx; color: #5f983a; font-size: 22rpx; }
.link-form { margin-top: 22rpx; padding: 22rpx; border-radius: 20rpx; background: #f4ead6; }.link-input { box-sizing: border-box; width: 100%; height: 78rpx; margin-top: 16rpx; padding: 0 20rpx; border: 2rpx solid #ddcfbc; border-radius: 14rpx; background: #fffaf1; font-size: 24rpx; }.link-code-row { display: flex; align-items: center; gap: 14rpx; }.code-input { flex: 1; min-width: 0; }.link-code-row button { flex: 0 0 210rpx; padding: 0 10rpx; font-size: 21rpx; }
