<scroll-view class="page" scroll-y>
  <view class="hero">
    <text class="eyebrow">MY SHUSHUGO</text>
    <text class="title">我的收集日</text>
    <text class="subtitle">账号、权益和学习数据都集中放在这里</text>
  </view>
  <view class="card">
    <view class="row"><text class="label">当前状态</text><text class="value {{entitlement.active ? 'active' : ''}}">{{entitlement.active ? 'Pro' : '免费版'}}</text></view>
    <text wx:if="{{entitlement.expiresAt}}" class="detail">到期：{{entitlement.expiresAt}}</text>
  </view>
  <view class="card">
    <view class="row"><text class="label">账号</text><text class="value">{{auth.signedIn ? '已登录' : '未登录'}}</text></view>
    <text class="detail">微信未关联过账号时会先询问：创建新账号，或验证已有账号邮箱后关联。</text>
    <button class="secondary small" loading="{{busy}}" disabled="{{busy}}" bindtap="signIn">微信登录</button>
    <button class="ghost small" loading="{{busy}}" disabled="{{busy}}" bindtap="openWechatLink">已有账号？关联微信</button>
    <view wx:if="{{showWechatLink}}" class="link-form">
      <text class="section-title">关联到已有收集日账号</text>
      <text class="detail">验证码会发送到账号邮箱。Apple 登录账号也可以用已登记邮箱验证。</text>
      <input class="link-input" type="text" value="{{linkEmail}}" maxlength="254" placeholder="账号邮箱" bindinput="inputLinkEmail" />
      <view class="link-code-row">
        <input class="link-input code-input" type="number" value="{{linkCode}}" maxlength="6" placeholder="6 位验证码" bindinput="inputLinkCode" />
        <button class="ghost small" loading="{{busy}}" disabled="{{busy}}" bindtap="sendWechatLinkCode">发送验证码</button>
      </view>
      <button class="primary small" loading="{{busy}}" disabled="{{busy}}" bindtap="linkWechatAccount">验证并关联当前微信</button>
    </view>
    <navigator class="legal-link" url="/pages/legal/index">用户协议与隐私政策 →</navigator>
  </view>
  <view class="card"><text class="section-title">每日学习量</text><text class="detail">圆环、数字和备考一键共用同一份计划。</text><navigator class="legal-link" url="/pages/daily-plan/index">调整今天的学习量 →</navigator></view>
  <view class="card"><view class="row"><text class="label">答题音效</text><switch checked="{{soundOn}}" color="#69a840" bindchange="toggleSound" /></view><text class="detail">翻卡与连击提示音，跟网页使用同一偏好。</text></view>
  <view class="card" wx:if="{{reminder.configured}}">
    <view class="row"><text class="label">学习提醒</text><text class="value">{{reminder.credits > 0 ? '已攒 ' + reminder.credits + ' 条' : '还没授权'}}</text></view>
    <text class="detail">翻面、评分时会静默攒一条微信提醒额度；哪天没学，晚上 8 点提醒一次。{{reminder.lastSentOn ? '上次提醒：' + reminder.lastSentOn : ''}}</text>
    <button class="ghost small" bindtap="openReminderSetting">在微信里管理订阅</button>
  </view>
  <button wx:if="{{pendingPayment}}" class="ghost" loading="{{busy}}" disabled="{{busy}}" bindtap="checkPendingPayment">重新确认最近一笔支付</button>
  <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="refreshEntitlement">刷新权益</button>
  <view class="card">
    <text class="section-title">购买 Pro</text>
    <text class="detail">月卡、季卡、年卡都是单次购买；到期后停止，不会自动扣费。已有付费 Pro 时不能重复购买期限卡，可升级永久版。</text>
    <text wx:if="{{!auth.signedIn}}" class="detail">请先登录收集日账号，再购买并同步权益。</text>
    <button wx:for="{{plans}}" wx:key="id" class="secondary" loading="{{busy}}" disabled="{{busy || !auth.signedIn}}" data-id="{{item.id}}" data-price-cents="{{item.priceCents}}" bindtap="buyPro">{{item.name}} · ¥{{item.priceYuan}}</button>
  </view>
  <view class="card maintenance-card">
    <text class="section-title">数据与内容</text>
    <text class="detail">学习页面只负责学习；更新、同步、备份和恢复集中在这里。</text>
    <button class="secondary small" loading="{{busy}}" disabled="{{busy}}" bindtap="handleContentUpdate">检查内容更新</button>
    <button wx:if="{{auth.signedIn}}" class="secondary small" loading="{{busy}}" disabled="{{busy}}" bindtap="handleSync">同步进度</button>
    <text wx:else class="detail">登录收集日账号后可同步学习进度。</text>
    <button class="ghost small" loading="{{busy}}" disabled="{{busy}}" bindtap="handleExportBackup">导出学习备份</button>
    <button class="ghost small" loading="{{busy}}" disabled="{{busy}}" bindtap="handleImportBackup">合并学习备份</button>
  </view>
  <view class="card">
    <text class="section-title">关于收集日</text>
    <text class="detail">把日语，收集成每天的进步。</text>
    <navigator class="legal-link" url="/features/about/index">了解收集日 →</navigator>
  </view>
  <view wx:if="{{result}}" class="card result">{{result}}</view>
  <view class="notice">支付不会打开站外网页；购买结果会经过微信确认，并同步到你的账号。</view>
</scroll-view>
