page { background: #f4ead6; color: #3a2e22; }
.page { box-sizing: border-box; min-height: 100vh; padding: 36rpx 30rpx 80rpx; }
.hero { position: relative; overflow: hidden; padding: 40rpx 34rpx 42rpx; border-radius: 32rpx; background: #fbf5e9; box-shadow: 0 12rpx 28rpx rgba(91, 67, 42, .07); }
.mascot { display: block; width: 104rpx; height: 104rpx; margin-bottom: 34rpx; border-radius: 24rpx; background: #dfeef2; }
.eyebrow, .title, .intro, .feature-number, .feature-title, .feature-copy, .status-title, .status-copy { display: block; }
.eyebrow { color: #5f983a; font-size: 20rpx; font-weight: 800; letter-spacing: 2rpx; }
.title { margin-top: 16rpx; max-width: 600rpx; font-size: 47rpx; font-weight: 900; line-height: 1.25; }
.intro { margin-top: 20rpx; color: #806f5c; font-size: 25rpx; line-height: 1.65; }
.section-heading { padding: 34rpx 8rpx 10rpx; }
.section-kicker, .section-title { display: block; }
.section-kicker { color: #5f983a; font-size: 20rpx; font-weight: 800; }
.section-title { margin-top: 8rpx; font-size: 32rpx; font-weight: 850; line-height: 1.35; }
.features { margin-top: 12rpx; }
.feature { margin-bottom: 16rpx; padding: 28rpx 30rpx; border-radius: 26rpx; background: #fbf5e9; }
.feature-number { color: #6f9eaa; font-size: 19rpx; font-weight: 800; letter-spacing: 1rpx; }
.feature-title { margin-top: 10rpx; font-size: 30rpx; font-weight: 850; }
.feature-copy { margin-top: 8rpx; color: #806f5c; font-size: 23rpx; line-height: 1.55; }
.status { margin-top: 10rpx; padding: 32rpx 30rpx; border: 2rpx solid #ddcfbc; border-radius: 26rpx; }
.status-title { color: #675747; font-size: 27rpx; font-weight: 850; }
.status-copy { margin-top: 10rpx; color: #806f5c; font-size: 22rpx; line-height: 1.6; }
