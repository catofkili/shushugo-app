.feature-page{min-height:100vh;padding:28rpx 28rpx 80rpx;box-sizing:border-box;color:#29352a}
.feature-hero{margin-bottom:24rpx;padding:32rpx;border-radius:34rpx;background:linear-gradient(145deg,#fffaf0,#edf4df);box-shadow:0 12rpx 30rpx rgba(82,67,44,.08)}
.feature-kicker{display:block;color:#69934c;font-size:22rpx;font-weight:700;letter-spacing:.12em}
.feature-title{display:block;margin-top:10rpx;font-size:46rpx;font-weight:800;line-height:1.18}
.feature-copy{display:block;margin-top:14rpx;color:#766f64;font-size:26rpx;line-height:1.65}
.panel{margin-top:20rpx;padding:28rpx;border-radius:var(--ds-radius-card,40rpx);background:#fffdf8;box-shadow:0 8rpx 24rpx rgba(82,67,44,.07)}
.panel-title{font-size:var(--ds-font-size-section,26rpx);font-weight:800}
.muted{color:#8a8177;font-size:var(--ds-font-size-body,28rpx);line-height:1.6}
.chip-row{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:18rpx}
.chip{padding:12rpx 22rpx;border-radius:999rpx;background:#f3eadb;color:#6d665e;font-size:24rpx}
.chip.active{background:#6f9f4d;color:#fff}
.primary,.secondary{margin-top:22rpx;border:0;border-radius:var(--ds-radius-button,28rpx);font-size:var(--ds-font-size-button,30rpx);font-weight:700}
.primary{background:#6f9f4d;color:#fff}
.secondary{background:#efe9df;color:#5d574f}
.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}
.divider{height:1rpx;margin:24rpx 0;background:#eee5d8}
.empty{padding:70rpx 20rpx;text-align:center;color:#968d82}
.metric-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx;margin-top:20rpx}
.metric{padding:22rpx;border-radius:22rpx;background:#f5f0e6}
.metric-value{display:block;font-size:38rpx;font-weight:800;color:#315d35}
.metric-label{display:block;margin-top:4rpx;color:#857c70;font-size:22rpx}
.list-title{display:block;font-size:30rpx;font-weight:800;line-height:1.4}
.list-sub{display:block;margin-top:6rpx;color:#8b8176;font-size:23rpx;line-height:1.5}
.badge{padding:6rpx 14rpx;border-radius:999rpx;background:#edf3e4;color:#5c813f;font-size:21rpx;font-weight:700}
.field{margin-top:16rpx;padding:20rpx;border-radius:18rpx;background:#f6f0e6;font-size:27rpx}
.danger{color:#ae5b4e}
