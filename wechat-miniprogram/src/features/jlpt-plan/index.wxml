<scroll-view class="feature-page" scroll-y>
  <view class="feature-hero">
    <text class="feature-kicker">JLPT PLAN</text>
    <text class="feature-title">备考计划</text>
    <text class="feature-copy">按范围内真实的未学量、到期量和考期算今天最低做多少；考前 {{status ? status.plan.consolidationDays : 21}} 天进入巩固期，不再塞新内容。</text>
  </view>
  <view class="panel" wx:if="{{error}}"><text class="danger">{{error}}</text></view>

  <view class="panel">
    <text class="panel-title">目标级别</text>
    <view class="chip-row"><text wx:for="{{targets}}" wx:key="*this" class="chip {{target === item ? 'active' : ''}}" data-value="{{item}}" bindtap="pickTarget">{{item}}</text></view>
    <picker mode="date" value="{{examDate}}" bindchange="pickDate"><view class="field">考试日期：{{status.examDateHuman || examDate}}（{{sourceText}}）˅</view></picker>
    <button wx:if="{{examDateInput}}" class="secondary" bindtap="clearDate">改回自动（7 月 / 12 月首个周日）</button>
    <text class="muted">报名前以官方考点通知为准。</text>
  </view>

  <view class="panel" wx:if="{{status}}">
    <view class="row"><text class="panel-title">今日最低量</text><text class="badge">{{phaseText}} · 还剩 {{status.plan.daysLeft}} 天</text></view>
    <view class="metric-grid">
      <view class="metric"><text class="metric-value">{{status.done.newWordsDone}} / {{status.plan.newWords}}</text><text class="metric-label">新词</text></view>
      <view class="metric"><text class="metric-value">{{status.done.reviewWordsDone}} / {{status.plan.reviewWords}}</text><text class="metric-label">复习词</text></view>
      <view class="metric"><text class="metric-value">{{status.done.newGrammarDone}} / {{status.plan.newGrammar}}</text><text class="metric-label">新语法</text></view>
      <view class="metric"><text class="metric-value">{{status.done.reviewGrammarDone}} / {{status.plan.reviewGrammar}}</text><text class="metric-label">语法复习</text></view>
    </view>
    <text class="muted">{{shortfallText}}</text>
    <text wx:if="{{!status.plan.feasible}}" class="feature-copy danger">按每日上限（新词 50 / 新语法 12）也覆盖不完，至少需要 {{status.plan.daysNeeded}} 天。建议降一级目标或改考期，而不是硬塞。</text>
  </view>

  <view class="panel" wx:if="{{status}}">
    <text class="panel-title">覆盖进度</text>
    <view class="coverage"><text class="muted">词汇 {{status.coverage.words.seen}} / {{status.coverage.words.total}}</text><view class="progress"><view style="width:{{wordPercent}}%"></view></view></view>
    <view class="coverage"><text class="muted">语法 {{status.coverage.grammar.seen}} / {{status.coverage.grammar.total}}</text><view class="progress"><view style="width:{{grammarPercent}}%"></view></view></view>
  </view>
</scroll-view>
