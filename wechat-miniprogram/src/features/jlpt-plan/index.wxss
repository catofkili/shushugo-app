@import "../common.wxss";
.date-input{margin-top:14rpx;padding:18rpx;border-radius:18rpx;background:#f5efe5}.phase{font-weight:800;color:#315d35}.coverage{margin-top:14rpx}.progress{height:16rpx;margin-top:8rpx;border-radius:999rpx;background:#eee6d8;overflow:hidden}.progress view{height:100%;background:#88b866}
.section-label{display:block;margin-top:28rpx;color:#29352a;font-size:28rpx;font-weight:800}.familiarity-row{margin-top:18rpx;color:#29352a;font-size:25rpx}.familiarity-row slider{margin:4rpx 0}.kana-symbol{display:block;margin:20rpx 0;text-align:center;color:#315d35;font-size:112rpx;font-weight:800}.choice-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14rpx;margin-top:20rpx}.choice-grid button{margin:0;border-radius:18rpx;background:#edf3e4;color:#315d35;font-weight:800}
.panel-title{display:block}.panel-title+.muted{display:block;margin-top:10rpx}.setup-starts,.setup-levels{display:grid;gap:10rpx;margin-top:12rpx}.setup-starts{grid-template-columns:repeat(2,minmax(0,1fr))}.setup-levels{grid-template-columns:repeat(5,minmax(0,1fr))}.setup-starts .chip,.setup-levels .chip{box-sizing:border-box;width:100%;min-width:0;min-height:74rpx;margin:0;padding:0 4rpx;line-height:74rpx;text-align:center;font-size:23rpx}.setup-footer{position:fixed;left:0;right:0;bottom:0;z-index:10;padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff9ed;box-shadow:0 -8rpx 24rpx rgba(82,67,44,.08)}.setup-footer .primary{box-sizing:border-box;width:100%;margin:0}.feature-page{padding-bottom:180rpx}
.setup-preview{margin-top:24rpx;padding:22rpx;border-radius:18rpx;background:#fff;border:1rpx solid #ddcfba}.setup-preview .muted,.setup-preview .danger{display:block;margin-top:10rpx;line-height:1.55}
.setup-exams{grid-template-columns:repeat(2,minmax(0,1fr))}.setup-exams .chip{display:flex;align-items:center;justify-content:center;min-height:76rpx;padding:10rpx 8rpx;line-height:1.3}.exam-presets{box-sizing:border-box;width:100%;margin-top:14rpx;white-space:nowrap}.exam-presets .exam-preset{display:inline-block;width:auto;min-height:68rpx;margin:0 12rpx 0 0;padding:12rpx 18rpx;line-height:44rpx;font-size:22rpx;vertical-align:top}.date-field{margin-bottom:8rpx}
