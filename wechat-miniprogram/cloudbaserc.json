{
  "version": "2.0",
  "envId": "cloud1-d3g7dauie3961575b",
  "region": "ap-shanghai",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "api",
      "runtime": "Nodejs18.15",
      "timeout": 60,
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "WORKER_ORIGIN": "https://api.shushugo.com"
      },
      "triggers": [
        {
          "name": "keep-worker-warm",
          "type": "timer",
          "config": "0 */4 * * * * *"
        }
      ]
    },
    {
      "name": "reminder",
      "runtime": "Nodejs18.15",
      "timeout": 60,
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "REMINDER_TEMPLATE_ID": "TODO",
        "REMINDER_DATA": "thing1=今天的单词还没复习;time2={date}"
      },
      "triggers": [
        {
          "name": "daily",
          "type": "timer",
          "config": "0 0 20 * * * *"
        }
      ]
    },
    {
      "name": "talk-asr",
      "runtime": "Nodejs18.15",
      "timeout": 60,
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "TALK_ASR_DAILY_LIMIT": "100"
      }
    }
  ]
}
